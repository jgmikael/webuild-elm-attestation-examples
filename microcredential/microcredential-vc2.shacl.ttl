# Derived W3C VC 2.0 validation profile — 2026-10-27
# Source: microcredential-elm.shacl.ttl, supplied earlier in this conversation.
# Changes: root adds VC 2.0 type/validFrom; mc:TransportShape is no longer invoked.
# All learning-data, QA, date, ECTS-XOR and SHOULD constraints remain unchanged.
# TransportShape below is retained only as an unused reference to the original.
# This is a draft application profile, not a full VC conformance or trust checker.
# Validate the entire issued RDF graph, not an arbitrary selectively disclosed subset.
# Text uses language-tagged strings. Points use numeric xsd:string values.
# ELM grade/decision follow the prior OWL-based profile's string interpretation.
# All mc: terms are DRAFT terms under example.org, not an adopted WE BUILD vocabulary.
# The original SD-JWT profile remains unchanged in its separate original file.

@prefix mc:   <https://example.org/webuild/microcredential/profile/> .
@prefix elm:  <http://data.europa.eu/snb/model/ontology/> .
@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rov:  <http://www.w3.org/ns/regorg#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

# Domain extensions: no exact ELM property for a stacking-intent boolean or a
# general QA category independent of an assertion that accreditation exists.
mc:stackable a rdf:Property ; rdfs:range xsd:boolean .
mc:qualityAssurance a rdf:Property ; rdfs:range xsd:string .
mc:attestation_legal_category a rdf:Property ; rdfs:range xsd:string .

mc:CredentialShape a sh:NodeShape ;
  sh:targetClass elm:EuropeanDigitalCredential ;
  sh:property
    [ sh:path mc:attestation_legal_category ; sh:hasValue "non-qualified-EAA" ; sh:maxCount 1 ],
    [ sh:path adms:identifier ; sh:name "identifier" ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:IdentifierShape ],
    [ sh:path elm:displayParameter ; sh:minCount 1 ; sh:maxCount 1 ; sh:class elm:DisplayParameter ;
      sh:node [ sh:property [ sh:path dct:title ; sh:name "title" ; sh:minCount 1 ; sh:node mc:TextShape ] ] ],
    [ sh:path cred:issuer ; sh:name "iss" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
      sh:class elm:Organisation ; sh:node mc:IssuerShape ],
    [ sh:path cred:issued ; sh:name "issuanceDate" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ],
    [ sh:path cred:credentialSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:LearnerShape ],
    [ sh:path mc:qualityAssurance ; sh:name "qualityAssurance" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
    [ sh:path elm:additionalNote ; sh:name "additionalNote" ; sh:node mc:NoteShape ] ;
  sh:node mc:VC2EnvelopeShape ;
  sh:sparql [ sh:message "issuanceDate must not be in the future or precede a supplied assessment completion date." ;
    sh:select """SELECT $this WHERE {
      $this <https://www.w3.org/2018/credentials#issued> ?issued .
      FILTER (?issued > NOW() || EXISTS {
        $this <https://www.w3.org/2018/credentials#credentialSubject>/<http://data.europa.eu/snb/model/ontology/hasClaim>/<http://data.europa.eu/snb/model/ontology/provenBy>/<http://purl.org/dc/terms/issued> ?completed .
        FILTER (?completed > ?issued)
      })
    }""" ] ;
  sh:sparql [ sh:message "accreditation.type must match qualityAssurance (same code in skos:notation)." ;
    sh:select """SELECT $this WHERE {
      $this <https://example.org/webuild/microcredential/profile/qualityAssurance> ?qa ;
        <https://www.w3.org/2018/credentials#credentialSubject>/<http://data.europa.eu/snb/model/ontology/hasClaim>/<http://data.europa.eu/snb/model/ontology/awardedBy>/<http://data.europa.eu/snb/model/ontology/awardingBody>/<http://data.europa.eu/snb/model/ontology/accreditation>/<http://purl.org/dc/terms/type>/<http://www.w3.org/2004/02/skos/core#notation> ?kind .
      FILTER (STR(?qa) != STR(?kind))
    }""" ] .

mc:LearnerShape a sh:NodeShape ; sh:class elm:Person ;
  sh:property
    [ sh:path foaf:givenName ; sh:name "givenName" ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:TextShape ],
    [ sh:path foaf:familyName ; sh:name "familyName" ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:TextShape ],
    [ sh:path elm:dateOfBirth ; sh:name "dateOfBirth" ; sh:maxCount 1 ; sh:datatype xsd:dateTime ],
    [ sh:path elm:placeOfBirth ; sh:name "placeOfBirth" ; sh:maxCount 1 ; sh:node mc:TextLocationShape ],
    [ sh:path elm:citizenshipCountry ; sh:name "citizenshipCountry" ; sh:node mc:CountryShape ],
    [ sh:path elm:nationalId ; sh:name "nationalID" ; sh:maxCount 1 ; sh:class elm:LegalIdentifier ; sh:node mc:NotationShape ],
    [ sh:path elm:location ; sh:name "registeredAddress" ; sh:maxCount 1 ; sh:node mc:TextLocationShape ],
    [ sh:path elm:contactPoint ; sh:class elm:ContactPoint ; sh:node [ sh:property
      [ sh:path elm:emailAddress ; sh:name "mail" ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^mailto:[^@ ]+@[^@ ]+$" ] ] ],
    [ sh:path elm:hasClaim ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:AchievementShape ] ;
  sh:sparql [ sh:message "dateOfBirth must not be in the future." ; sh:select """SELECT $this WHERE {
    $this <http://data.europa.eu/snb/model/ontology/dateOfBirth> ?d . FILTER (?d > NOW())
  }""" ] .

mc:AchievementShape a sh:NodeShape ; sh:class elm:LearningAchievement ;
  sh:property
    [ sh:path elm:awardedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class elm:AwardingProcess ],
    [ sh:path ( elm:awardedBy elm:awardingBody ) ; sh:name "awardingBody" ; sh:minCount 1 ; sh:node mc:AwardingBodyShape ],
    [ sh:path elm:specifiedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:SpecificationShape ],
    [ sh:path elm:provenBy ; sh:node mc:AssessmentShape ] ;
  sh:sparql [ sh:message "An actual assessment must refer to an assessment specification listed for this achievement." ;
    sh:select """SELECT $this WHERE {
      $this <http://data.europa.eu/snb/model/ontology/provenBy>/<http://data.europa.eu/snb/model/ontology/specifiedBy> ?a .
      FILTER NOT EXISTS { $this <http://data.europa.eu/snb/model/ontology/specifiedBy>/<http://data.europa.eu/snb/model/ontology/provenBy> ?a }
    }""" ] .

mc:SpecificationShape a sh:NodeShape ; sh:class elm:LearningAchievementSpecification ;
  sh:property
    [ sh:path elm:learningOutcome ; sh:name "learningOutcomes" ; sh:minCount 1 ; sh:node mc:OutcomeShape ],
    [ sh:path elm:creditPoint ; sh:name "ECTS" ; sh:maxCount 1 ; sh:node mc:ECTSShape ],
    [ sh:path elm:volumeOfLearning ; sh:name "volumeOfLearning" ; sh:maxCount 1 ; sh:datatype xsd:duration ],
    [ sh:path elm:EQFLevel ; sh:name "level" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/snb/eqf/[1-8]$" ],
    [ sh:path elm:NQFLevel ; sh:name "nationalQualificationsFrameworkLevel" ; sh:node mc:ConceptShape ],
    [ sh:path elm:educationLevel ; sh:name "educationLevelDescriptor" ; sh:node mc:ConceptShape ],
    [ sh:path elm:learningOutcomeSummary ; sh:name "learningOutcomeSummary" ; sh:maxCount 1 ; sh:node mc:NoteShape ],
    [ sh:path elm:ISCEDFCode ; sh:name "fieldOfEducation" ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/snb/isced-f/" ],
    [ sh:path elm:provenBy ; sh:name "typeOfAssessment" ; sh:minCount 1 ; sh:node mc:AssessmentSpecificationShape ],
    [ sh:path elm:influencedBy ; sh:minCount 1 ; sh:node mc:ActivitySpecificationShape ],
    [ sh:path elm:entryRequirement ; sh:name "entryRequirements" ; sh:node mc:NoteShape ],
    [ sh:path mc:stackable ; sh:name "stackable" ; sh:maxCount 1 ; sh:datatype xsd:boolean ],
    [ sh:path elm:isPartOf ; sh:name "partOfQualification" ; sh:class elm:Qualification ; sh:node [ sh:or (
      [ sh:nodeKind sh:IRI ] [ sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:node mc:TextShape ] ] ) ] ] ;
  sh:xone (
    [ sh:property [ sh:path elm:creditPoint ; sh:minCount 1 ] ; sh:property [ sh:path elm:volumeOfLearning ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path elm:volumeOfLearning ; sh:minCount 1 ] ; sh:property [ sh:path elm:creditPoint ; sh:maxCount 0 ] ]
  ) ;
  sh:sparql [ sh:message "EQF/NQF levels require the specification also to be typed elm:Qualification (OWL domain)." ;
    sh:select """SELECT $this WHERE {
      $this ?p ?level . FILTER (?p IN (<http://data.europa.eu/snb/model/ontology/EQFLevel>, <http://data.europa.eu/snb/model/ontology/NQFLevel>))
      FILTER NOT EXISTS { $this a <http://data.europa.eu/snb/model/ontology/Qualification> }
    }""" ] .

mc:OutcomeShape a sh:NodeShape ; sh:class elm:LearningOutcome ; sh:property
  [ sh:path dct:title ; sh:minCount 1 ; sh:node mc:TextShape ],
  [ sh:path dct:description ; sh:minCount 1 ; sh:node mc:TextShape ],
  [ sh:path elm:relatedESCOSkill ; sh:name "escoReference" ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/esco/skill/" ] .

mc:ECTSShape a sh:NodeShape ; sh:class elm:CreditPoint ; sh:property
  [ sh:path elm:point ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[+]?[0-9]+([.][0-9]+)?$" ],
  [ sh:path elm:framework ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:node [ sh:property
    [ sh:path skos:notation ; sh:hasValue "ECTS" ; sh:maxCount 1 ] ] ] ;
  sh:sparql [ sh:message "ECTS must be positive." ; sh:select """SELECT $this WHERE {
    $this <http://data.europa.eu/snb/model/ontology/point> ?p .
    FILTER (<http://www.w3.org/2001/XMLSchema#decimal>(?p) <= 0)
  }""" ] .

mc:AssessmentSpecificationShape a sh:NodeShape ; sh:class elm:LearningAssessmentSpecification ; sh:property
  [ sh:path dct:type ; sh:name "typeOfAssessment" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/snb/assessment/" ],
  [ sh:path dct:language ; sh:name "languageOfAssessment" ; sh:node mc:ConceptShape ],
  [ sh:path elm:gradingScheme ; sh:name "gradingScheme" ; sh:maxCount 1 ; sh:class elm:GradingScheme ; sh:node [ sh:property
    [ sh:path dct:title ; sh:minCount 1 ; sh:node mc:TextShape ] ] ] .

mc:AssessmentShape a sh:NodeShape ; sh:class elm:LearningAssessment ; sh:property
  [ sh:path elm:grade ; sh:name "grade" ; sh:maxCount 1 ; sh:datatype xsd:string ],
  [ sh:path elm:idVerification ; sh:name "idVerificationMethod" ; sh:maxCount 1 ; sh:node mc:ConceptShape ],
  [ sh:path elm:specifiedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:AssessmentSpecificationShape ],
  [ sh:path dct:issued ; sh:description "Optional assessment completion time; not an extra rulebook claim." ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

mc:ActivitySpecificationShape a sh:NodeShape ; sh:class elm:LearningActivitySpecification ; sh:property
  [ sh:path elm:mode ; sh:name "formOfParticipation" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/snb/learning-assessment/" ],
  [ sh:path dct:type ; sh:name "learningActivityType" ; sh:maxCount 1 ; sh:node mc:ConceptShape ] .

mc:IssuerShape a sh:NodeShape ; sh:property
  [ sh:path ( elm:location elm:address elm:countryCode ) ; sh:name "issuerCountry" ; sh:minCount 1 ; sh:node mc:CountryShape ] .

mc:AwardingBodyShape a sh:NodeShape ; sh:class elm:Organisation ; sh:property
  [ sh:path rov:legalName ; sh:name "awardingBody.legalName" ; sh:minCount 1 ; sh:node mc:TextShape ],
  [ sh:path rov:registration ; sh:name "awardingBody.legalIdentifier" ; sh:maxCount 1 ; sh:class elm:LegalIdentifier ; sh:node mc:NotationShape ],
  [ sh:path adms:identifier ; sh:name "awardingBodyIdentifier" ; sh:node mc:IdentifierShape ],
  [ sh:path elm:location ; sh:name "awardingBodyAddress" ; sh:node mc:TextLocationShape ],
  [ sh:path foaf:homepage ; sh:name "awardingBodyHomepage" ; sh:nodeKind sh:IRI ; sh:pattern "^https?://" ],
  [ sh:path elm:accreditation ; sh:name "accreditation" ; sh:node mc:AccreditationShape ] .

mc:AccreditationShape a sh:NodeShape ; sh:class elm:Accreditation ; sh:property
  [ sh:path dct:title ; sh:name "accreditation.title" ; sh:node mc:TextShape ],
  [ sh:path dct:type ; sh:name "accreditation.type" ; sh:minCount 1 ; sh:maxCount 1 ; sh:node mc:CodedConceptShape ],
  [ sh:path elm:accreditingAgent ; sh:name "accreditation.accreditingAgent" ; sh:maxCount 1 ; sh:class elm:Organisation ; sh:node [ sh:property
    [ sh:path rov:legalName ; sh:minCount 1 ; sh:node mc:TextShape ] ] ],
  [ sh:path elm:decision ; sh:name "accreditation.decision" ; sh:maxCount 1 ; sh:datatype xsd:string ],
  [ sh:path dct:issued ; sh:name "accreditation.decisionDate" ; sh:maxCount 1 ; sh:datatype xsd:dateTime ],
  [ sh:path elm:reviewDate ; sh:name "accreditation.reviewDate" ; sh:maxCount 1 ; sh:datatype xsd:dateTime ],
  [ sh:path elm:limitField ; sh:name "accreditation field limits" ; sh:node mc:ConceptShape ],
  [ sh:path elm:limitJurisdiction ; sh:name "accreditation jurisdiction limits" ; sh:node mc:ConceptShape ],
  [ sh:path elm:limitEQFLevel ; sh:name "accreditation EQF limits" ; sh:nodeKind sh:IRI ; sh:pattern "^http://data[.]europa[.]eu/snb/eqf/[1-8]$" ] .

# Shared value shapes. Require the complete lexical value, not merely a node link.
mc:TextShape a sh:NodeShape ; sh:datatype rdf:langString ; sh:minLength 1 .
mc:NoteShape a sh:NodeShape ; sh:class elm:Note ; sh:property
  [ sh:path elm:noteLiteral ; sh:minCount 1 ; sh:node mc:TextShape ] .
mc:NotationShape a sh:NodeShape ; sh:property
  [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
mc:IdentifierShape a sh:NodeShape ; sh:class elm:Identifier ; sh:node mc:NotationShape .
mc:ConceptShape a sh:NodeShape ; sh:class skos:Concept ; sh:or (
  [ sh:nodeKind sh:IRI ] [ sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:datatype xsd:string ] ] ) .
mc:CodedConceptShape a sh:NodeShape ; sh:class skos:Concept ; sh:node mc:NotationShape .
mc:CountryShape a sh:NodeShape ; sh:nodeKind sh:IRI ;
  sh:pattern "^http://publications[.]europa[.]eu/resource/authority/country/[A-Z]{3}$" .
mc:TextLocationShape a sh:NodeShape ; sh:class dct:Location ; sh:property
  [ sh:path elm:address ; sh:minCount 1 ; sh:class elm:Address ],
  [ sh:path ( elm:address elm:fullAddress ) ; sh:minCount 1 ; sh:node mc:NoteShape ] .

# Transport projection: draft properties preserve claims with no ELM equivalent.
# iss maps to cred:issuer IRI above, distinct from the awarding organisation.
# jti stays separate from identifier; iat stays separate from issuanceDate.
# exp/nbf are NumericDate integers, NOT learning-achievement expiry dates.
# cnf/status use rdf:JSON typed literals; validate their internal structure and
# cryptographic semantics against the actual SD-JWT/JOSE/status specifications.
mc:TransportShape a sh:NodeShape ; sh:property
  [ sh:path mc:vct ; sh:hasValue "https://webuildconsortium.eu/credentials/microcredential/1.0" ; sh:maxCount 1 ],
  [ sh:path mc:iat ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ],
  [ sh:path mc:cnf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:JSON ],
  [ sh:path mc:exp ; sh:maxCount 1 ; sh:datatype xsd:integer ],
  [ sh:path mc:nbf ; sh:maxCount 1 ; sh:datatype xsd:integer ],
  [ sh:path mc:jti ; sh:maxCount 1 ; sh:datatype xsd:string ],
  [ sh:path mc:status ; sh:maxCount 1 ; sh:datatype rdf:JSON ],
  [ sh:path mc:trust_anchor ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ],
  [ sh:path mc:cryptographically_bound_to ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# SHOULD rules produce warnings; they must not become unconditional SHALL rules.
mc:StackingAdvice a sh:NodeShape ; sh:targetObjectsOf elm:specifiedBy ; sh:severity sh:Warning ;
  sh:sparql [ sh:message "stackable=true: include partOfQualification (SHOULD)." ; sh:select """SELECT $this WHERE {
    $this <https://example.org/webuild/microcredential/profile/stackable> true .
    FILTER NOT EXISTS { $this <http://data.europa.eu/snb/model/ontology/isPartOf> ?q }
  }""" ] .
mc:GradingAdvice a sh:NodeShape ; sh:targetObjectsOf elm:provenBy ; sh:severity sh:Warning ;
  sh:sparql [ sh:message "grade present: include gradingScheme (SHOULD)." ; sh:select """SELECT $this WHERE {
    $this <http://data.europa.eu/snb/model/ontology/grade> ?g .
    FILTER NOT EXISTS { $this <http://data.europa.eu/snb/model/ontology/specifiedBy>/<http://data.europa.eu/snb/model/ontology/gradingScheme> ?s }
  }""" ] .

# VCDM 2.0-specific envelope. validUntil remains optional.
mc:VC2EnvelopeShape a sh:NodeShape ;
  sh:class cred:VerifiableCredential ; sh:and ( [ sh:class mc:MicrocredentialCredential ] ) ;
  sh:property
    [ sh:path cred:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ],
    [ sh:path cred:validUntil ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:sparql [ sh:message "validUntil must not precede validFrom." ; sh:select """SELECT $this WHERE {
    $this <https://www.w3.org/2018/credentials#validFrom> ?from ;
      <https://www.w3.org/2018/credentials#validUntil> ?until . FILTER (?until < ?from)
  }""" ] .
